# PostgreSQL

POSTGRES_DB=marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Kafka

KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092

# Kafka UI

KAFKA_UI_PORT=8080

# Debezium

DEBEZIUM_PORT=8083

# Airflow

AIRFLOW_UID=1000
AIRFLOW_GID=1000
AIRFLOW_PROJ_DIR=.
AIRFLOW__CORE__FERNET_KEY=

# Dedicated, scoped IAM User for Airflow's own AWS credential (Terraform:
# module.airflow_ingest, environments/dev/security.tf) -- covers exactly
# what Airflow's extract_postgres task and CloudWatch remote task logging
# do (raw/ S3 read-write, the Airflow CloudWatch log group). Get real
# values with `terraform output -raw airflow_ingest_access_key_id` /
# `-raw airflow_ingest_secret_access_key` (environments/dev) after
# applying. No IAM role available (local dev machine, not EC2/ECS) -- see
# ADR-003.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Personal terraform-admin key -- still needed by dbt_run_gold/
# dbt_test_gold (marketplace_batch_pipeline.py's BashOperator env
# override, dbt needs real Athena/Glue/S3 write access to build Gold).
# A dedicated identity for this (module.dbt_gold, mdp-dbt-gold-dev) now
# exists in Terraform but isn't wired in here yet -- see
# roadmap-next-steps.md. bronze-consumer no longer uses this pair (see
# MDP_BRONZE_CONSUMER_* below) -- same ~/.aws/credentials [default]
# profile AWS_ACCESS_KEY_ID/SECRET used to hold above, before the
# mdp-airflow-ingest-dev split.
MDP_PERSONAL_ACCESS_KEY_ID=
MDP_PERSONAL_SECRET_ACCESS_KEY=

# mdp-dbt-gold-dev IAM User (Terraform: module.dbt_gold,
# environments/dev/security.tf) -- dedicated, least-privilege
# credential for dbt_run_gold/dbt_test_gold
# (marketplace_batch_pipeline.py's BashOperator env override): Athena
# mdp-athena-dbt-dev, Glue read mdp_silver_dev / write mdp_gold_dev,
# S3 read silver/ + read-write gold/. Get real values with `terraform
# output -raw dbt_gold_access_key_id` / `-raw
# dbt_gold_secret_access_key` (environments/dev) after applying.
# Replaces MDP_PERSONAL_ACCESS_KEY_ID/SECRET above for this specific
# use -- see roadmap-next-steps.md.
MDP_DBT_GOLD_ACCESS_KEY_ID=
MDP_DBT_GOLD_SECRET_ACCESS_KEY=

# Full ARN of the CloudWatch Log Group Airflow's remote logging ships
# task logs to (infrastructure/terraform/modules/monitoring/cloudwatch,
# module.cloudwatch_airflow in environments/dev/monitoring.tf).
AIRFLOW_CLOUDWATCH_LOG_GROUP_ARN=

# Sprint 13 close-out: this project's own structlog JSON lines
# (data_platform.observability.logging_config.configure_logging()) --
# a separate CloudWatch destination from
# AIRFLOW_CLOUDWATCH_LOG_GROUP_ARN above, which is Airflow's own
# task-log stream. Covered by the same AWS_ACCESS_KEY_ID/SECRET IAM
# grant above (infrastructure/terraform/environments/dev/security.tf).
PLATFORM_CLOUDWATCH_LOG_GROUP=

# Databricks token for the Airflow databricks_default Connection --
# dedicated PAT, not the personal OAuth session in ~/.databrickscfg.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Sprint 13 close-out: read directly by
# integrations/databricks/observability/run_output_shipper.py (the
# ship_databricks_run_logs task, marketplace_batch_pipeline.py) -- a
# separate, more narrowly-scoped log group and IAM grant from
# PLATFORM_CLOUDWATCH_LOG_GROUP above (see
# infrastructure/terraform/environments/dev/security.tf,
# CloudWatchDatabricksLogs).
DATABRICKS_CLOUDWATCH_LOG_GROUP=

# Grafana admin password -- optional, docker-compose.yml falls back to
# "admin" if unset.
GRAFANA_ADMIN_PASSWORD=admin

# BI Reader IAM User (Terraform: module.bi_reader, environments/dev/security.tf)
# -- read-only credential for Metabase's Athena connection, scoped to
# the Gold layer only. Get real values with `terraform output -raw
# bi_reader_access_key_id` / `-raw bi_reader_secret_access_key`
# (environments/dev) after applying. NOT the same pair as
# AWS_ACCESS_KEY_ID/SECRET above (that one is full-access).
MDP_BI_READER_ACCESS_KEY_ID=
MDP_BI_READER_SECRET_ACCESS_KEY=

# Bronze Consumer IAM User (Terraform: module.bronze_consumer,
# environments/dev/security.tf) -- dedicated, least-privilege
# credential for the bronze-consumer container: bronze/ S3 read-write
# only (append-only Delta writes, no DeleteObject). Get real values
# with `terraform output -raw bronze_consumer_access_key_id` / `-raw
# bronze_consumer_secret_access_key` (environments/dev) after applying.
# docker-compose.yml's bronze-consumer service already references
# this pair, but the swap hasn't been rolled out to the running
# container yet (needs a real value here + `docker compose up -d
# bronze-consumer`, deliberately deferred to Frente 3's close -- see
# roadmap-next-steps.md). Leave this blank until that's approved.
MDP_BRONZE_CONSUMER_ACCESS_KEY_ID=
MDP_BRONZE_CONSUMER_SECRET_ACCESS_KEY=

# mdp-bronze-maintenance-dev IAM User (Terraform:
# module.bronze_maintenance, environments/dev/security.tf) --
# dedicated, least-privilege credential for
# bronze_streaming_maintenance.py's optimize_bronze/vacuum_bronze
# tasks: bronze/ S3 list/get/put/delete. Deliberately separate from
# MDP_BRONZE_CONSUMER_* above, which is append-only (no delete). Get
# real values with `terraform output -raw
# bronze_maintenance_access_key_id` / `-raw
# bronze_maintenance_secret_access_key` (environments/dev) after
# applying.
MDP_BRONZE_MAINTENANCE_ACCESS_KEY_ID=
MDP_BRONZE_MAINTENANCE_SECRET_ACCESS_KEY=

# Real Telegram contact point for Grafana alerts (bot @AlertasMDP_bot)
# -- monitoring/grafana/provisioning/alerting/contactpoints.yml reads
# these via its own $TELEGRAM_BOT_TOKEN/$TELEGRAM_CHAT_ID provisioning
# expansion (docker-compose.yml's grafana service passes them through
# as plain container env vars, not GF_*-prefixed).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Real email contact point for Grafana alerts (second channel
# alongside Telegram above) -- docker-compose.yml's grafana service
# maps these three to the native GF_SMTP_* env vars Grafana's own
# [smtp] server config reads (not provisioning-file $VAR expansion,
# unlike Telegram above). Dedicated Gmail account, app password (not
# the account password).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# mdp-email contact point's recipient (contactpoints.yml addresses
# field, via its own $ALERT_EMAIL_TO provisioning expansion) -- same
# address as SMTP_USER above by deliberate choice (delivery can be
# confirmed via that same account's IMAP), but a separate var so the
# recipient stays independently configurable from the sender account.
ALERT_EMAIL_TO=
