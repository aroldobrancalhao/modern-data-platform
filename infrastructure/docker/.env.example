# PostgreSQL

POSTGRES_DB=marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Kafka

KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092

# Kafka UI

KAFKA_UI_PORT=8080

# Debezium

DEBEZIUM_PORT=8083

# Airflow

AIRFLOW_UID=1000
AIRFLOW_GID=1000
AIRFLOW_PROJ_DIR=.
AIRFLOW__CORE__FERNET_KEY=

# Dedicated, scoped IAM User for Airflow's own AWS credential (Terraform:
# module.airflow_ingest, environments/dev/security.tf) -- covers exactly
# what Airflow's extract_postgres task and CloudWatch remote task logging
# do (raw/ S3 read-write, the Airflow CloudWatch log group). Get real
# values with `terraform output -raw airflow_ingest_access_key_id` /
# `-raw airflow_ingest_secret_access_key` (environments/dev) after
# applying. No IAM role available (local dev machine, not EC2/ECS) -- see
# ADR-003.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Personal terraform-admin key -- still needed by (1) dbt_run_gold/
# dbt_test_gold (marketplace_batch_pipeline.py's BashOperator env
# override, dbt needs real Athena/Glue/S3 write access to build Gold,
# deliberately left out of mdp-airflow-ingest-dev's scope -- see
# roadmap-next-steps.md) and (2) bronze-consumer's own compose block
# (separate container, unrelated write path to bronze/). Same
# ~/.aws/credentials [default] profile AWS_ACCESS_KEY_ID/SECRET used to
# hold above, before the mdp-airflow-ingest-dev split.
MDP_PERSONAL_ACCESS_KEY_ID=
MDP_PERSONAL_SECRET_ACCESS_KEY=

# Full ARN of the CloudWatch Log Group Airflow's remote logging ships
# task logs to (infrastructure/terraform/modules/monitoring/cloudwatch,
# module.cloudwatch_airflow in environments/dev/monitoring.tf).
AIRFLOW_CLOUDWATCH_LOG_GROUP_ARN=

# Databricks token for the Airflow databricks_default Connection --
# dedicated PAT, not the personal OAuth session in ~/.databrickscfg.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Grafana admin password -- optional, docker-compose.yml falls back to
# "admin" if unset.
GRAFANA_ADMIN_PASSWORD=admin

# BI Reader IAM User (Terraform: module.bi_reader, environments/dev/security.tf)
# -- read-only credential for Metabase's Athena connection, scoped to
# the Gold layer only. Get real values with `terraform output -raw
# bi_reader_access_key_id` / `-raw bi_reader_secret_access_key`
# (environments/dev) after applying. NOT the same pair as
# AWS_ACCESS_KEY_ID/SECRET above (that one is full-access).
MDP_BI_READER_ACCESS_KEY_ID=
MDP_BI_READER_SECRET_ACCESS_KEY=
