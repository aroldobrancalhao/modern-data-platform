# Root .env.example -- app-level vars: the simulator
# (src/simulator/core/settings.py, env_file=<repo root>/.env), any
# standalone script that imports its get_settings()
# (scripts/backfill_order_status.py), and ad-hoc credentials like the
# Metabase admin session below.
#
# For docker-compose's own vars (Postgres/Kafka/Airflow bootstrap,
# AWS/IAM credentials, Databricks, alerting), see
# infrastructure/docker/.env.example instead -- separate file by
# Docker Compose's own default, not an arbitrary project choice:
# `docker compose -f infrastructure/docker/docker-compose.yml ...`
# resolves .env relative to the compose file's own directory
# regardless of where you invoke it from (confirmed live, 2026-08-13:
# a var only defined in infrastructure/docker/.env still resolved
# correctly when compose was run with -f from the repo root).
# `--env-file` can point it elsewhere, but replaces the source
# entirely rather than merging the two -- consolidating into this
# file would mean physically moving every docker-compose var here and
# passing --env-file from the Makefile, not just documenting a link.
# Decided against that for now: keeps two files in sync (see the
# POSTGRES_* note below) over one file two ways to invoke correctly.
#
# POSTGRES_HOST/PORT/USER/PASSWORD below overlap in *name* with
# infrastructure/docker/.env.example's POSTGRES_PORT/USER/PASSWORD --
# not the same setting. These are the app's connection to
# postgres-marketplace from the host (POSTGRES_HOST=localhost, the
# published port); those are the container's own bootstrap
# credentials (POSTGRES_DB/USER/PASSWORD baked into the Postgres
# image on first boot). Currently kept at matching values by hand --
# nothing enforces that; change one, check the other.

# PostgreSQL (app connection, from the host)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Simulator -- pacing
SIMULATOR_BATCH_SIZE=1000
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_INSERT_BATCH_SIZE=500
SIMULATOR_RESTOCK_PROBABILITY=0.08

# Simulator -- initial load
INITIAL_CATALOG=true

# Simulator -- master data volume per batch
SELLERS_PER_BATCH=10
CATEGORIES_PER_BATCH=20
WAREHOUSES_PER_BATCH=5
PRODUCTS_PER_SELLER=50

# Simulator -- transactional data volume per batch
CUSTOMERS_PER_BATCH=1000
ORDERS_PER_BATCH=1000
REVIEWS_PER_BATCH=400

# Simulator -- orders
MAX_ORDER_ITEMS=5

# Simulator -- inventory
INITIAL_STOCK_MIN=100
INITIAL_STOCK_MAX=1000

# Simulator -- feature toggles
ENABLE_PAYMENTS=true
ENABLE_SHIPMENTS=true
ENABLE_REVIEWS=true

# Logging
LOG_LEVEL=INFO

# Metabase admin session credential (POST /api/session) -- used to
# script per-card visualization_settings via the API, same discipline
# as dashboards/metabase/ being SQL-as-code instead of UI-only. Real
# value is whatever this Metabase instance's admin account actually
# is -- there's no Terraform output or fixed default for this one.
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=
